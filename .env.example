# Bookmark storage (MongoDB) — required by /api/bookmarks
# Connection string from MongoDB Atlas or your own server.
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@playlearn.0brv5or.mongodb.net/?appName=playlearn
# Optional: database name (defaults to "vplaylearn")
MONGODB_DB=vplaylearn

# Suggestions email (Resend) — required by /api/suggestions
RESEND_API_KEY=
SUGGESTIONS_TO_EMAIL=
RESEND_FROM_EMAIL=

# Authentication (Clerk) — required for login
# From the Clerk dashboard (https://dashboard.clerk.com) -> API Keys.
# Publishable key is public and injected into the browser bundle at build time.
CLERK_PUBLISHABLE_KEY=pk_test_xxx
# Secret key is server-side only (used by serverless functions to verify tokens).
# Never expose this to the client.
CLERK_SECRET_KEY=sk_test_xxx
